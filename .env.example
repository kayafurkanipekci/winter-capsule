# Supabase (server-side only)
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Storage bucket name (must match the bucket created in SQL)
SUPABASE_PHOTO_BUCKET=kapsul-photos

# Timezone
CAPSULE_TZ=Europe/Istanbul

# Development/testing only (leave unset in production)
# CAPSULE_NOW_OVERRIDE=2027-01-01T00:05:00+03:00
